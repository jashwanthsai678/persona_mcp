ANTHROPIC_API_KEY=sk-ant-...

# Signs session cookies for the web platform. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBAPP_SECRET_KEY=

# Used only by the local single-tenant CLI/server (persona_mcp/ingest.py, server.py),
# not by the web platform (webapp/).
PERSONA_NAME=
# Optional: override where personas/ lives, defaults to the repo root.
# PERSONA_MCP_HOME=D:\Memory-agent-mcp\personas
