# Signs session cookies for the web platform. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBAPP_SECRET_KEY=

# Supabase: hosts user accounts + persona metadata (name, status, bio, style
# profile, mcp_token). Project Settings > API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Qdrant: hosts the actual embedded memory per persona.
QDRANT_URL=
QDRANT_API_KEY=

# Used only by the local single-tenant CLI/server (persona_mcp/ingest.py,
# server.py), not by the web platform (webapp/). Still needs QDRANT_URL/
# QDRANT_API_KEY above (vector memory is Qdrant everywhere now), but is
# otherwise independent of Supabase/the web app's accounts.
PERSONA_NAME=
# Optional: override where personas/ lives, defaults to the repo root.
# PERSONA_MCP_HOME=D:\Memory-agent-mcp\personas
